---
import { getT, path, site, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const h = 'label text-paper/50';
const a = 'underline-offset-4 decoration-lime decoration-2 hover:underline';
---

<footer class="on-ink overflow-hidden bg-ink text-paper">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:gap-12 md:py-16">
    <div class="col-span-2 md:col-span-1">
      <p class="flex items-center gap-2.5 font-display text-2xl font-semibold tracking-tight">
        <span class="size-4 rounded-full bg-lime" aria-hidden="true"></span>pausoriano
      </p>
      <p class="mt-4 max-w-xs leading-relaxed text-paper/65">{t.footer.tagline}</p>
    </div>

    <nav aria-label={t.footer.services}>
      <p class={h}>{t.footer.services}</p>
      <ul class="mt-4 space-y-3">
        <li><a class={a} href={path('gestion', lang)}>{t.servicePages.gestion.name}</a></li>
        <li><a class={a} href={path('consultoria', lang)}>{t.servicePages.consultoria.name}</a></li>
        <li class="hidden md:block"><a class={a} href={site.calendly} target="_blank" rel="noopener">{t.ui.cta}</a></li>
      </ul>
    </nav>

    <nav aria-label={t.footer.legal}>
      <p class={h}>{t.footer.legal}</p>
      <ul class="mt-4 space-y-3">
        <li><a class={a} href={path('privacy', lang)}>{t.legalPages.privacy.title}</a></li>
        <li><a class={a} href={path('legal', lang)}>{t.legalPages.legal.title}</a></li>
      </ul>
    </nav>

    <div class="col-span-2 md:col-span-1">
      <p class={h}>{t.footer.contact}</p>
      <ul class="mt-4 space-y-3">
        <li><a class={a} href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class={a} href={site.linkedin} target="_blank" rel="noopener me">LinkedIn</a></li>
        <li><a class={a} href={site.instagram} target="_blank" rel="noopener me">Instagram</a></li>
      </ul>
    </div>
  </div>

  <p class="wrap select-none pb-10 font-display text-[clamp(3.5rem,17.5vw,17rem)] leading-[1] font-semibold tracking-tighter text-paper/[0.06]" data-parallax="40,0" data-pend="bottom bottom" aria-hidden="true">pausoriano</p>
  <div class="border-t border-paper/20 py-5 text-center label text-paper/50">© 2026 Pau Soriano · pausoriano.es</div>
</footer>
