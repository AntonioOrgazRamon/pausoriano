---
import { fmt, getT, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
---

<section id="faq" class="border-b border-ink/15 py-14 sm:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
      <p data-reveal class="label text-muted">(06) {t.faq.eyebrow}</p>
      <h2 class="display mt-6 text-[clamp(2.2rem,4.4vw,4rem)]" set:html={fmt(t.faq.title)} />
    </div>

    <div class="border-t border-ink/15 lg:col-span-8">
      {
        t.faq.items.map((f) => (
          <details class="group border-b border-ink/15">
            <summary class="flex items-start justify-between gap-6 py-6 text-left">
              <h3 class="font-display text-xl leading-snug font-medium tracking-tight sm:text-2xl">{f.q}</h3>
              <span class="faq-icon mt-0.5 grid size-9 shrink-0 place-items-center rounded-full border border-ink/25 font-mono text-xl leading-none" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-2xl pb-8 text-lg leading-relaxed text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
