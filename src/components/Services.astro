---
import { fmt, getT, path, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const cards = ['gestion', 'consultoria'] as const;
---

<section id="servicios" class="border-b border-ink/15 py-14 sm:py-28">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12">
      <p data-reveal class="label text-muted lg:col-span-4">(01) {t.services.eyebrow}</p>
      <h2 class="display text-[clamp(2.2rem,5vw,4.5rem)] lg:col-span-8" set:html={fmt(t.services.title)} />
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-[2rem] border border-ink/15 bg-ink/15 lg:grid-cols-2">
      {
        cards.map((key, i) => {
          const s = t.servicePages[key];
          return (
            <article
              data-reveal
              style={`--d:${i * 80}ms`}
              class="group relative flex flex-col bg-paper p-6 transition-colors duration-500 hover:bg-ink hover:text-paper sm:p-10"
            >
              <div class="flex items-start justify-between gap-6">
                <p class="label">{s.kicker}</p>
                <span class="font-display text-7xl leading-none font-semibold tracking-tighter text-ink/[0.07] transition-colors group-hover:text-lime sm:text-8xl" aria-hidden="true">0{i + 1}</span>
              </div>
              <h3 class="display mt-4 text-[clamp(1.9rem,3.4vw,3rem)]">{s.name}</h3>
              <p class="mt-4 max-w-md leading-relaxed opacity-80">{s.intro}</p>

              <ul class="mt-8 divide-y divide-current/20 border-y border-current/20">
                {s.bullets.slice(0, 4).map((b, n) => (
                  <li class:list={['gap-4 py-3 text-[0.95rem] leading-snug', n === 3 ? 'hidden md:flex' : 'flex']}>
                    <span class="font-mono font-bold text-ink transition-colors group-hover:text-lime" aria-hidden="true">+</span>
                    {b}
                  </li>
                ))}
              </ul>

              <p class="mt-6 hidden text-sm leading-relaxed opacity-70 md:block">
                <span class="label opacity-100">{t.ui.forWho}:</span> {s.forWho}
              </p>

              <a
                href={path(key, lang)}
                class="btn btn-primary mt-8 w-full justify-between sm:w-auto sm:self-start after:absolute after:inset-0 after:content-['']"
              >
                {t.ui.moreInfo} <span class="arrow" aria-hidden="true">→</span>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
