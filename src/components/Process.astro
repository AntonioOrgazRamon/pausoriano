---
import { fmt, getT, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
---

<section id="proceso" class="border-b border-ink/15 bg-paper-2 py-14 sm:py-28">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12">
      <p data-reveal class="label text-muted lg:col-span-4">(04) {t.process.eyebrow}</p>
      <h2 class="display text-[clamp(2.2rem,5vw,4.5rem)] lg:col-span-8" set:html={fmt(t.process.title)} />
    </div>

    <ol data-snap class="snap-row mt-10 md:mt-14 md:grid md:grid-cols-3 md:gap-px md:overflow-hidden md:rounded-[2rem] md:border md:border-ink/15 md:bg-ink/15 md:p-0">
      {
        t.process.steps.map((s, i) => (
          <li
            data-reveal
            style={`--d:${i * 90}ms`}
            class="snap-card flex flex-col bg-paper p-6 sm:p-9"
          >
            <span
              class="proc-num font-display text-[7rem] leading-[0.8] font-medium tracking-tighter text-transparent [-webkit-text-stroke:1px_var(--color-ink)] sm:text-[9rem]"
              aria-hidden="true"
            >
              0{i + 1}
            </span>
            <p class="label mt-8 text-muted">{s.when}</p>
            <h3 class="display mt-3 text-[clamp(1.6rem,2.4vw,2.2rem)]">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{s.text}</p>
            <ul class="mt-auto flex flex-wrap gap-2 pt-8">
              {s.chips.map((c) => <li class="chip">{c}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
    <div class="snap-dots mt-5 flex justify-center gap-2 md:hidden" aria-hidden="true">
      {t.process.steps.map(() => <span></span>)}
    </div>
  </div>
</section>
