---
import { fmt, getT, path, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const check = new Set(['Incluida', 'Incluidas', 'Included']);
---

<section class="border-b border-ink/15 py-14 sm:py-28">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12">
      <p data-reveal class="label text-muted lg:col-span-4">(03) {t.compare.eyebrow}</p>
      <h2 class="display text-[clamp(2.2rem,5vw,4.5rem)] lg:col-span-8" set:html={fmt(t.compare.title)} />
    </div>

    <div data-reveal class="mt-10 space-y-3 md:hidden">
      {
        t.compare.rows.map((r) => (
          <div class="rounded-2xl border border-ink/15 p-4">
            <p class="label text-muted">{r.label}</p>
            <dl class="mt-3 grid grid-cols-2 gap-5 text-[0.95rem] leading-snug">
              {[r.a, r.b].map((v, n) => (
                <div>
                  <dt class="label text-ink/50">{t.compare.cols[n]}</dt>
                  <dd class="mt-1.5 flex items-start gap-2">
                    {check.has(v) && <span class="mt-px inline-grid size-5 shrink-0 place-items-center rounded-full bg-lime text-xs font-bold" aria-hidden="true">✓</span>}
                    <span>{v}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>

    <div data-reveal class="mt-14 hidden overflow-hidden rounded-[2rem] border border-ink/15 md:block">
      <table class="w-full border-collapse text-left text-[0.9rem] sm:text-base">
        <thead>
          <tr class="bg-paper-2">
            <th scope="col" class="p-3 sm:p-5"><span class="sr-only">—</span></th>
            <th scope="col" class="border-l border-ink/15 p-3 font-display text-lg font-semibold sm:p-5 sm:text-2xl">
              <a href={path('gestion', lang)} class="underline decoration-lime decoration-[3px] underline-offset-4">{t.compare.cols[0]}</a>
            </th>
            <th scope="col" class="border-l border-ink/15 p-3 font-display text-lg font-semibold sm:p-5 sm:text-2xl">
              <a href={path('consultoria', lang)} class="underline decoration-lime decoration-[3px] underline-offset-4">{t.compare.cols[1]}</a>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            t.compare.rows.map((r) => (
              <tr class="border-t border-ink/10">
                <th scope="row" class="label w-[28%] p-3 align-top sm:p-5">{r.label}</th>
                <td class="border-l border-ink/10 p-3 align-top sm:p-5">
                  {check.has(r.a) && <span class="mr-2 inline-grid size-5 place-items-center rounded-full bg-lime text-xs font-bold" aria-hidden="true">✓</span>}
                  {r.a}
                </td>
                <td class="border-l border-ink/10 p-3 align-top sm:p-5">
                  {check.has(r.b) && <span class="mr-2 inline-grid size-5 place-items-center rounded-full bg-lime text-xs font-bold" aria-hidden="true">✓</span>}
                  {r.b}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
