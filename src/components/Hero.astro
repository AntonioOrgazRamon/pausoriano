---
import Funnel from './Funnel.astro';
import { fmt, getT, path, site, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const tags = [...t.hero.tags, ...t.hero.tags, ...t.hero.tags, ...t.hero.tags];
---

<section class="pt-28 sm:pt-36">
  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p data-hero="0" class="label text-muted">({t.hero.eyebrow})</p>
      <h1 data-hero="1" class="display mt-6 text-[clamp(2.5rem,5.2vw,5rem)] !font-normal" set:html={fmt(t.hero.title)} />

      <p data-hero="2" class="mt-8 max-w-xl text-lg leading-relaxed text-ink/80">{t.hero.sub}</p>
      <div data-hero="3" class="mt-9 flex flex-wrap items-center gap-3">
        <a href={site.calendly} target="_blank" rel="noopener" class="btn btn-primary w-full justify-between sm:w-auto sm:justify-center">
          {t.ui.ctaLong} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href={`${path('home', lang)}#servicios`} class="btn btn-ghost hidden sm:inline-flex">{t.ui.nav.services}</a>
        <p class="label ml-1 text-muted">↳ {t.hero.note}</p>
      </div>
    </div>

    <div data-hero="4" class="mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <Funnel lang={lang} />
    </div>
  </div>

  <!-- Lo básico: tres cifras reales de su propio FAQ -->
  <div class="wrap mt-12 sm:mt-20">
    <dl data-reveal class="grid divide-y divide-ink/10 border-y border-ink/15 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {
        t.hero.facts.map((f) => (
          <div class="py-4 sm:px-8 sm:py-6 sm:first:pl-0 sm:last:pr-0">
            <dt class="label text-muted">{f.k}</dt>
            <dd class="display mt-1.5 text-[1.6rem] sm:mt-3 sm:text-[clamp(1.8rem,3.2vw,2.8rem)]">{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Banda: verticales con las que trabajo -->
  <div class="mt-10 overflow-hidden border-t border-ink/10 py-5 sm:mt-16 sm:py-6" aria-hidden="true">
    <div class="marquee-track flex w-max">
      {
        [...tags, ...tags].map((tag) => (
          <span class="flex items-center font-display text-2xl font-normal tracking-tight text-ink/70 sm:text-3xl">
            <span class="px-9">{tag}</span>
            <span class="size-2 rounded-full bg-lime ring-1 ring-ink/20"></span>
          </span>
        ))
      }
    </div>
  </div>
</section>
