---
import { fmt, getT, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
---

<section class="border-b border-ink/15 py-14 sm:py-28">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12">
      <p data-reveal class="label text-muted lg:col-span-4">(05) {t.principles.eyebrow}</p>
      <h2 class="display text-[clamp(2.2rem,5vw,4.5rem)] lg:col-span-8" set:html={fmt(t.principles.title)} />
    </div>

    <ul data-snap class="snap-row mt-10 md:mt-14 md:grid md:grid-cols-2 md:gap-px md:overflow-hidden md:rounded-[2rem] md:border md:border-ink/15 md:bg-ink/15 md:p-0 lg:grid-cols-4">
      {
        t.principles.items.map((p, i) => (
          <li
            data-reveal
            style={`--d:${i * 70}ms`}
            class="snap-card group bg-paper p-6 transition-colors duration-300 hover:bg-lime/60 sm:p-8"
          >
            <span class="label text-muted group-hover:text-ink">0{i + 1}</span>
            <h3 class="display mt-10 text-[1.6rem]">{p.t}</h3>
            <p class="mt-3 leading-relaxed text-muted group-hover:text-ink">{p.d}</p>
          </li>
        ))
      }
    </ul>
    <div class="snap-dots mt-5 flex justify-center gap-2 md:hidden" aria-hidden="true">
      {t.principles.items.map(() => <span></span>)}
    </div>
  </div>
</section>
