---
import { fmt, getT, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const d = t.ai.demo;
const who = [d.you, d.rival];
---

<section class="on-ink border-b border-ink/15 bg-ink py-14 text-paper sm:py-32">
  <div class="wrap">
    <p data-reveal class="label text-paper/60">(02) {t.ai.eyebrow}</p>
    <h2 class="display mt-6 max-w-6xl text-[clamp(2.2rem,5.4vw,5rem)]" set:html={fmt(t.ai.title)} />

    <!-- Demostración: la misma pregunta, la misma respuesta -->
    <div data-demo class="mt-14 sm:mt-16">
      <p data-demo-tag class="label mb-4 text-paper/50">{d.tag}</p>
      <div class="grid items-stretch gap-4 md:grid-cols-[1fr_auto_1fr]">
        {
          who.map((name, i) => (
            <>
              {i === 1 && (
                <div data-demo-eq class="hidden items-center justify-center font-display text-4xl text-lime md:flex md:px-2" aria-hidden="true">=</div>
              )}
              <div data-demo-card class:list={['rounded-[1.75rem] border border-paper/15 bg-paper/[0.04] p-5 sm:p-7', i === 1 && 'hidden md:block']}>
                <p class="label text-paper/60">
                  {i === 0 ? (<><span class="md:hidden">{d.you} = {d.rival}</span><span class="hidden md:inline">{name}</span></>) : name}
                </p>
                <p data-demo-q class="mt-4 ml-auto w-fit max-w-[90%] rounded-2xl rounded-tr-md bg-paper/10 px-4 py-3 text-[0.95rem] leading-snug">{d.prompt}</p>
                <ol data-demo-a class="mt-4 space-y-1.5 rounded-2xl rounded-tl-md border border-paper/10 px-4 py-4 text-[0.95rem] leading-snug text-paper/75">
                  {d.answer.map((a, n) => (
                    <li class="flex gap-3">
                      <span class="font-mono text-xs text-paper/40" aria-hidden="true">{n + 1}.</span>
                      {a}
                    </li>
                  ))}
                </ol>
              </div>
            </>
          ))
        }
      </div>
      <p data-demo-same class="display mt-6 text-[clamp(1.4rem,2.4vw,2rem)] text-lime">{d.same}</p>
    </div>

    <div class="mt-16 border-t border-paper/15 pt-12 sm:mt-20 sm:pt-16">
      <!-- Se ilumina palabra a palabra al hacer scroll -->
      <p data-scrub class="font-display text-[clamp(1.55rem,3.3vw,3rem)] leading-[1.2] font-medium tracking-tight max-w-5xl">{t.ai.body}</p>
      <div data-reveal class="mt-14 grid gap-8 lg:grid-cols-12">
        <p class="display text-[clamp(1.8rem,3.2vw,2.8rem)] text-lime lg:col-span-6">{t.ai.punch}</p>
        <p class="text-lg leading-relaxed text-paper/85 lg:col-span-5 lg:col-start-8">{t.ai.close}</p>
      </div>
    </div>
  </div>
</section>
