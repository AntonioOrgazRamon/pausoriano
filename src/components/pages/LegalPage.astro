---
import Base from '../../layouts/Base.astro';
import { getT, path, site, type Lang } from '../../i18n';
import { breadcrumbLd, webPageLd } from '../../i18n/schema';

interface Props {
  lang: Lang;
  page: 'privacy' | 'legal';
}
const { lang, page } = Astro.props;
const t = getT(lang);
const content = t.legalPages[page];
const meta = t.meta[page];
const jsonLd = [webPageLd(lang, page, meta.title, meta.description), breadcrumbLd(lang, page, content.title)];

// Convierte emails y www.aepd.es en enlaces
const linkify = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/(contacto@pausoriano\.es)/g, `<a href="mailto:${site.email}">$1</a>`)
    .replace(/(www\.aepd\.es)/g, '<a href="https://www.aepd.es" target="_blank" rel="noopener">$1</a>');
---

<Base lang={lang} routeKey={page} title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <article class="pt-28 pb-24 sm:pt-36">
    <div class="wrap max-w-3xl !mx-0 sm:!mx-auto">
      <a href={path('home', lang)} class="label underline-offset-4 hover:underline">← {t.ui.back}</a>
      <p class="label mt-10 text-muted">({t.ui.legal})</p>
      <h1 class="display mt-5 text-[clamp(2.4rem,6vw,4.5rem)]">{content.title}</h1>
      <p class="label mt-4 text-muted">{t.ui.lastUpdate}</p>

      <div class="prose-legal mt-6">
        {
          content.sections.map((s) => (
            <section>
              <h2>{s.h}</h2>
              {s.p.map((p) => <p set:html={linkify(p)} />)}
            </section>
          ))
        }
      </div>
    </div>
  </article>
</Base>
