---
// Embudo animado: el tráfico entra por arriba, el filtro deja pasar a los que encajan (se vuelven lima)
// y los que no se salen por el lateral. Al fondo, los clientes.
// SVG + SMIL: cero JS, cero imágenes. Con prefers-reduced-motion se muestra una versión estática.
import { getT, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const INK = '#0b0b0c';
const LIME = '#d9f56e';
const MUTED = '#a8a8a1';
const DUR = 8;
const MONO = "'JetBrains Mono Variable', monospace";
const DISPLAY = "'Bricolage Grotesque Variable', sans-serif";

// 16 puntos: 10 encajan (llegan a cliente) y 6 no encajan (se salen por la izquierda)
const fits = [66, 168, 100, 204, 132, 52, 150, 112, 186, 88].map((x, i) => ({ x, i, r: 4 + (i % 3) * 0.7 }));
const misses = [44, 78, 108, 60, 92, 70].map((x, i) => ({ x, i, r: 3.6 + (i % 2) * 0.8 }));
const total = fits.length + misses.length;
const slot = (n: number) => `-${((n * DUR) / total).toFixed(2)}s`;
// intercalamos para que no salgan en bloque
const dots = [
  ...fits.map((d, k) => ({ ...d, miss: false, begin: slot(k * 1.6 + 0) })),
  ...misses.map((d, k) => ({ ...d, miss: true, begin: slot(k * 2.6 + 1) })),
];
const hit = (x: number) => `M${x} 66 C${x} 220, 120 244, 120 478`;
const out = (x: number) => `M${x} 66 C${x} 160, ${x} 205, ${x - 4} 236 C${x - 10} 262, ${x - 46} 268, -34 336`;

const stat = {
  ink: [[62, 112], [150, 122], [104, 156], [186, 164], [84, 196], [140, 206], [112, 232]],
  lime: [[104, 300], [132, 332], [112, 380], [128, 420], [120, 452]],
  miss: [[34, 300], [12, 332], [-8, 366]],
};

const labels = [
  { y: 66, n: '01', text: t.hero.funnel[0], lx: 240 },
  { y: 250, n: '02', text: t.hero.funnel[1], lx: 178 },
  { y: 478, n: '03', text: t.hero.funnel[2], lx: 142 },
];
---

<figure class="m-0" data-parallax="0,-7" data-pstart="top top">
  <div class="rounded-[2rem] border border-ink/15 bg-paper-2 p-5 sm:p-7">
    <svg viewBox="-50 0 530 540" role="img" aria-label={t.hero.funnelAlt} class="h-auto w-full overflow-visible">
      <!-- relleno suave del embudo -->
      <path d="M20 66 C20 226 100 250 100 478 L140 478 C140 250 220 226 220 66 Z" fill={INK} fill-opacity="0.035" />
      <!-- paredes -->
      <path class="fn-wall" pathLength="1" d="M20 66 C20 226 100 250 100 478" fill="none" stroke={INK} stroke-opacity="0.4" />
      <path class="fn-wall" pathLength="1" d="M220 66 C220 226 140 250 140 478" fill="none" stroke={INK} stroke-opacity="0.4" />
      <path d="M20 66 H220" fill="none" stroke={INK} stroke-opacity="0.4" stroke-dasharray="2 5" />

      <!-- el filtro: una barra lima con latido -->
      <rect class="fn-bar" x="60" y="246" width="120" height="8" rx="4" fill={LIME} stroke={INK} stroke-width="1.2" />
      <rect x="60" y="246" width="120" height="8" rx="4" fill="none" stroke={INK} stroke-opacity="0.45" class="funnel-dots">
        <animate attributeName="y" values="246;238" dur="2s" repeatCount="indefinite" />
        <animate attributeName="height" values="8;24" dur="2s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0.55;0" dur="2s" repeatCount="indefinite" />
      </rect>

      <!-- guías y etiquetas -->
      {
        labels.map((l) => (
          <g class="fn-label">
            <line x1={l.lx} y1={l.y} x2="262" y2={l.y} stroke={INK} stroke-opacity="0.4" />
            <circle cx={l.lx} cy={l.y} r="2.5" fill={INK} />
            <text class="fn-num" x="274" y={l.y - 8} font-family={MONO} font-size="13" fill={INK} fill-opacity="0.55" letter-spacing="0.8">{l.n}</text>
            <text x="274" y={l.y + 22} font-family={DISPLAY} font-size="25" font-weight="500" fill={INK} letter-spacing="-0.4">{l.text}</text>
          </g>
        ))
      }
      <text class="fn-num" x="274" y="294" font-family={MONO} font-size="12" fill={INK} fill-opacity="0.55" letter-spacing="0.8">↳ {t.hero.funnelFilter.toUpperCase()}</text>

      <!-- cliente: círculo lima con pulso -->
      <circle class="fn-client" cx="120" cy="478" r="10" fill={LIME} stroke={INK} stroke-width="1.3" />
      <circle cx="120" cy="478" r="10" fill="none" stroke={INK} stroke-opacity="0.5" class="funnel-dots">
        <animate attributeName="r" values="10;28" dur="1.6s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0.6;0" dur="1.6s" repeatCount="indefinite" />
      </circle>

      <g class="funnel-dots fn-live">
        {
          dots.map((d) => (
            <circle r={d.r} fill={INK} stroke={INK} stroke-width="1" opacity="0">
              <animateMotion dur={`${DUR}s`} begin={d.begin} repeatCount="indefinite" path={d.miss ? out(d.x) : hit(d.x)} />
              <animate
                attributeName="opacity"
                dur={`${DUR}s`}
                begin={d.begin}
                repeatCount="indefinite"
                values={d.miss ? '0;1;1;0;0' : '0;1;1;0'}
                keyTimes={d.miss ? '0;0.05;0.55;0.85;1' : '0;0.05;0.95;1'}
              />
              <animate
                attributeName="fill"
                dur={`${DUR}s`}
                begin={d.begin}
                repeatCount="indefinite"
                values={d.miss ? `${INK};${INK};${MUTED};${MUTED}` : `${INK};${INK};${LIME};${LIME}`}
                keyTimes={d.miss ? '0;0.5;0.62;1' : '0;0.46;0.53;1'}
              />
              {!d.miss && (
                <animate
                  attributeName="r"
                  dur={`${DUR}s`}
                  begin={d.begin}
                  repeatCount="indefinite"
                  values={`${d.r};${d.r};${d.r + 1.6};${d.r + 1.6}`}
                  keyTimes="0;0.46;0.53;1"
                />
              )}
            </circle>
          ))
        }
      </g>

      <g class="funnel-static">
        {stat.ink.map(([x, y]) => <circle cx={x} cy={y} r="4.5" fill={INK} stroke={INK} stroke-width="1" />)}
        {stat.lime.map(([x, y]) => <circle cx={x} cy={y} r="5.5" fill={LIME} stroke={INK} stroke-width="1" />)}
        {stat.miss.map(([x, y]) => <circle cx={x} cy={y} r="4" fill={MUTED} stroke={MUTED} stroke-width="1" />)}
      </g>
    </svg>

    <!-- leyenda -->
    <ul class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-ink/10 pt-4 label text-muted">
      <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-[#a8a8a1]"></span>{t.hero.funnelLegend[0]}</li>
      <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-lime ring-1 ring-ink"></span>{t.hero.funnelLegend[1]}</li>
    </ul>
  </div>
</figure>
